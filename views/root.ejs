<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Réducteur d'URL</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 3rem auto; padding: 0 1rem; color: #1a1a1a; }
    form { display: flex; gap: .5rem; margin: 1.5rem 0; }
    input[type="url"] { flex: 1; padding: .5rem; font-size: 1rem; }
    button { padding: .5rem 1rem; font-size: 1rem; cursor: pointer; }
    .result, .error { padding: .75rem 1rem; border-radius: .25rem; margin: 1rem 0; }
    .result { background: #e6f4ea; border: 1px solid #b7dfc2; }
    .error { background: #fdecea; border: 1px solid #f3b9b3; }
    code { background: #f0f0f0; padding: .1rem .3rem; border-radius: .2rem; }
  </style>
</head>
<body>
  <h1>Réducteur d'URL</h1>

  <% if (count !== null) { %>
    <p><%= count %> lien(s) créé(s) jusqu'à présent.</p>
  <% } %>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <% if (link) { %>
    <div class="result">
      <p>Lien créé : <a href="/api-v2/<%= link.url %>"><code><%= link.url %></code></a></p>
      <p>Redirige vers : <%= link.origin %></p>
    </div>
  <% } %>

  <form method="post" action="/api-v2/" id="submit-link">
    <label for="url">Type the URL to shorten</label>
    <input name="url" id="url" type="url" placeholder="https://perdu.com" required />
    <button type="submit">Submit</button>
  </form>
</body>
</html>
